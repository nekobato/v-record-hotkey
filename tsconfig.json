{
	"compilerOptions": {
		"target": "ES2019",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2020", "DOM"],
		"esModuleInterop": true,
		"skipLibCheck": true,
		"strict": true,
		"declaration": true,
		"emitDeclarationOnly": false,
		"outDir": "dist",
		"sourceMap": true,
		"resolveJsonModule": true,
		"types": ["vitest/globals", "happy-dom"]
	},
	"include": ["src", "tests", "vitest.config.ts"],
	"exclude": ["dist", "node_modules"]
}
